# Go
*.exe
*.dll
*.so
*.dylib
*.test
*.out
bin/
vendor/
go.work
go.work.sum

# Node/Frontend
node_modules/
dist/
# Keep frontend/dist/.gitkeep so go:embed always has a target at build time.
!frontend/dist/
frontend/dist/*
!frontend/dist/.gitkeep
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local dev artifacts
/orchicon
/orchicon.exe
*.log
tmp/
data/
.dev/
.vite/
# In-worktree Go build/test scratch + cache dirs — workers set
# GOCACHE/GOTMPDIR inside the worktree so they stay tidy and get cleaned
# up; these are never committed.
.gotmp/
.go-tmp/
.gtmp/
# Go build cache (GOCACHE) — local dev artifact, never committed.
.gocache/
# Workflow-runner scratch caches (Go build/test + GOTMPDIR) — never committed.
.cache-build/
.qa-gocache/
.qa-gotmp/
# Per-project scratch dirs written by the control plane (run results,
# safety lint). Never committed.
/.orchicon/
# Worktrees Orchicon creates during work-item context. Never committed.
/.orchicon-worktrees/

# Architecture notes (worker-generated design summaries). Ephemeral per-work-item
# artifacts — never committed so they can't confuse future workers.
architecture-notes/
design-notes/

# CloudFlare Pages build artifacts (generated by scripts/build-site.sh
# at deploy time — source of truth is scripts/install.{sh,ps1}).
site/install
site/install.ps1
deploy/container/orchicon
deploy/runtime/orchicon
.playwright-mcp/

# Orchicon: ignore nested step worktrees (parallel-branch children)
01*/
