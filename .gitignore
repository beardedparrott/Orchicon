# Go
*.exe
*.dll
*.so
*.dylib
*.test
*.out
bin/
vendor/
go.work
go.work.sum

# Node/Frontend
node_modules/
dist/
# Keep frontend/dist/.gitkeep so go:embed always has a target at build time.
!frontend/dist/
frontend/dist/*
!frontend/dist/.gitkeep
# Playwright scratch: traces, screenshots, the HTML report (the diff-surface E2E
# spec writes its evidence captures here — artifacts, never sources).
frontend/test-results/
frontend/playwright-report/
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# --- The operator's own working notes (NOT part of the product) ---
# These are the personal files used to build Orchicon: the working inventory, the
# conventions to follow, and the role/developer notes. They are deliberately kept OUT of
# the repository — a reader of this project should see the product, not the notebook its
# author kept while writing it. They remain on the author's disk and are simply untracked.
#
# NOTE for anyone editing here: nothing in the build, the tests or the runtime READS these
# files from disk. References to "AGENTS.md" elsewhere in the tree are either comments about
# the conventions that used to live here, or the unrelated per-worker `agents_md` PROMPT
# FIELD (see internal/worker/service.go), which is stored in the database and is not this
# file. So removing them changes no behaviour.
AGENTS.md
UPDATES.md
developer.md
worker.md
CLOUDFLARE_SETUP.md

# The scratch prefix `make docs-check` installs the Mermaid parser into, so a docs check needs no
# dependency in the product or the frontend toolchain (CI uses $RUNNER_TEMP instead).
.mermaid-check/

# OS
.DS_Store
Thumbs.db

# Local dev artifacts
/orchicon
/orchicon.exe
*.log
tmp/
data/
.dev/
.vite/
# In-worktree Go build/test scratch + cache dirs — workers set
# GOCACHE/GOTMPDIR inside the worktree so they stay tidy and get cleaned
# up; these are never committed.
.gotmp/
.go-tmp/
.gtmp/
# Go build cache (GOCACHE) — local dev artifact, never committed.
.gocache/
# Workflow-runner scratch caches (Go build/test + GOTMPDIR) — never committed.
.cache-build/
.qa-gocache/
.qa-gotmp/
# Per-project scratch dirs written by the control plane (run results,
# safety lint). Never committed.
/.orchicon/
# Worktrees Orchicon creates during work-item context. Never committed.
/.orchicon-worktrees/

# Architecture notes (worker-generated design summaries). Ephemeral per-work-item
# artifacts — never committed so they can't confuse future workers.
architecture-notes/
design-notes/

# CloudFlare Pages build artifacts (generated by scripts/build-site.sh
# at deploy time — source of truth is scripts/install.{sh,ps1}).
site/install
site/install.ps1
deploy/container/orchicon
deploy/container/orch
deploy/runtime/orchicon
deploy/runtime/orch
# The TUI client binary (built by `make build` / `go build ./cmd/orch`);
# a bare `go build ./cmd/orch` drops it in the repo root.
/orch
/orch.exe
# Nested runtime state dir (root /.orchicon/ is ignored above).
/internal/orchicon/.orchicon/
.playwright-mcp/

# Orchicon: ignore nested step worktrees (parallel-branch children)
01*/
.restore-from-snapshot.sh
