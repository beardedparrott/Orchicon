# Orchicon local-development environment.
#
# Copy to .env and adjust. Values mirror deploy/compose/docker-compose.yml.
# The control plane reads these via internal/config (internal/config/config.go).

# Control plane listen addresses.
ORCHICON_HTTP_ADDR=:8080
ORCHICON_GRPC_ADDR=:9090

# Postgres (source of truth, docs/09).
ORCHICON_POSTGRES_DSN=postgres://orchicon:orchicon@localhost:5432/orchicon?sslmode=disable

# NATS JetStream (event bus, docs/08 §2).
ORCHICON_NATS_URL=nats://localhost:4222

# OTel collector OTLP endpoint (telemetry plane, docs/08 §5).
ORCHICON_OTEL_ENDPOINT=localhost:4317

# SigNoz query-service root (UI + API). The TelemetryService proxies
# tenant-scoped queries here (docs/08 §5, docs/10 §11). The frontend
# embeds the SigNoz UI same-origin under /signoz. Dev default matches
# deploy/compose (SigNoz UI on host :3301).
ORCHICON_SIGNOZ_URL=http://localhost:3301

# SigNoz root user password (impersonation mode, local dev only).
# Must meet: ≥12 chars, uppercase, lowercase, number, symbol.
SIGNOZ_USER_ROOT_PASSWORD=Orchicon-Dev-42!

# Local filesystem BlobStore (docs/01 §2).
ORCHICON_BLOB_DIR=./data/blobs

# Apply Atlas migrations on boot (docs/09 §8).
ORCHICON_MIGRATE_ON_BOOT=true

# --- Phase 9: Auth + deployment mode (docs/07 §6) ------------------------
# Deployment mode: "local" (fully-local dev) or "production". Every mode
# requires a real IdP — the embedded OP (default on, below) or an external
# issuer — validated on boot. Production additionally requires a real
# external issuer + signing key (BYO-IdP posture).
ORCHICON_MODE=local

# The single tenant this deployment owns (decision #178 — single-tenant
# per deployment). OIDC callback, dev-login, the embedded-OP local login,
# and the local-admin bootstrap all resolve logins into it, and boot
# provisions it via the tenant seed. Default tnt_dev; change it on an
# install to give the deployment a stable, distinct tenant (e.g. acme).
# Must be lowercase alphanumerics plus '-'/'_' (max 63 chars); a
# misconfigured value fails boot rather than silently seeding a second
# tenant. IdP identity claims are never consulted for tenant selection.
ORCHICON_DEPLOYMENT_TENANT_ID=tnt_dev

# External OIDC issuer URL. "local" = no external IdP (the embedded OP is
# the issuer). With the embedded OP disabled, this MUST be a real external
# issuer or the plane refuses to boot.
ORCHICON_OIDC_ISSUER=local
ORCHICON_OIDC_CLIENT_ID=orchicon
# ORCHICON_OIDC_CLIENT_SECRET=        # confidential-client secret (prod)
ORCHICON_OIDC_REDIRECT_URL=http://localhost:5173/auth/callback

# HMAC signing key for Orchicon-issued access + refresh tokens. In
# local mode the dev default is acceptable; production MUST set a
# strong random secret (config.Validate enforces this).
ORCHICON_AUTH_SIGNING_KEY=orchicon-dev-signing-key-change-in-production

# Synthetic /auth/dev-login endpoint (local mode only). Default OFF: it is
# a dev escape hatch for wedged flows, not the auth path. A fresh plane
# authenticates through the embedded OP local login, backed by the
# first-admin bootstrap credential below (or an external IdP).
ORCHICON_DEV_LOGIN=false

# --- Local-mode first-admin bootstrap (docs/07 §6.1) -----------------------
# With dev-login off and the anonymous bypass removed, a fresh local plane
# needs its first admin credential. On first boot (local mode, embedded OP
# enabled) the plane seeds an admin for the embedded-OP login:
#   ORCHICON_LOCAL_ADMIN_USERNAME  (default: admin)
#   ORCHICON_LOCAL_ADMIN_PASSWORD  (unset = the built-in default admin/admin)
# The unpinned default (admin/admin) is discoverable and self-expiring: the
# seeded credential is flagged for a forced password change, so the SPA
# shows a full-screen change-password gate on first login and the default
# stops working as soon as a new password is set. Pinning
# ORCHICON_LOCAL_ADMIN_PASSWORD skips the forced change (an explicit choice).
# The seed is idempotent and never overwrites an existing admin.
# Set ORCHICON_LOCAL_ADMIN_SEED=0 to disable it entirely (e.g. the prod
# dogfooding container, which also boots in local mode).
# Lost the admin password? Lockout reset: set ORCHICON_LOCAL_ADMIN_RESET=1
# (local mode + embedded OP only) and the next boot OVERWRITES the admin
# credential — identity + role binding preserved, password from
# ORCHICON_LOCAL_ADMIN_PASSWORD or the built-in default admin/admin (which
# re-arms the forced password change). Explicit opt-in and never a default;
# works even when ORCHICON_LOCAL_ADMIN_SEED=0.
# Unset it after signing back in so the next boot is normal.
# ORCHICON_LOCAL_ADMIN_USERNAME=admin
# ORCHICON_LOCAL_ADMIN_PASSWORD=change-me
# ORCHICON_LOCAL_ADMIN_SEED=1
# ORCHICON_LOCAL_ADMIN_RESET=1

# --- Embedded OpenID Provider (internal/auth/op) ---------------------------
# The in-process OP (zitadel/oidc v3) serves discovery/authorize/token/
# userinfo/jwks on the plane origin so local sign-in and any first-party
# RP can run a real code + PKCE flow against the plane itself. ID tokens
# are signed ES256 with a key deterministically derived from
# ORCHICON_AUTH_SIGNING_KEY (the HMAC secret itself is never published).
# Disable to expose no OP surface (e.g. a strict production plane that
# only trusts its BYO IdP).
ORCHICON_OP_ENABLED=true
# Comma-separated redirect URIs for the OP's built-in public client.
# Empty = default (ORCHICON_OIDC_REDIRECT_URL [+ the plane-origin
# /auth/callback when ORCHICON_OP_ISSUER is pinned]).
# ORCHICON_OP_REDIRECT_URIS=
# Pin the OP issuer URL (e.g. https://orchicon.example.com). Empty =
# dynamic from the request Host on every request.
# ORCHICON_OP_ISSUER=

# --- BlobStore backend (docs/01 §2) ---------------------------------------
# "local" = production-viable filesystem store; "s3" = S3-compatible.
ORCHICON_BLOB_STORE=local
# ORCHICON_S3_BUCKET=                  # required when BLOB_STORE=s3
# ORCHICON_S3_REGION=us-east-1
# ORCHICON_S3_ENDPOINT=               # empty for AWS; set for MinIO/etc.

# --- Runtime containers (workflow execution sandboxes) --------------------
# Base image the runtime daemon spawns per-workflow-run containers from.
# ORCHICON_RUNTIME_IMAGE=ghcr.io/beardedparrott/orchicon-runtime:latest
# Comma-separated allowlist of ADDITIONAL stock runtime images (the base
# is always included). UI-built custom images are accepted via the
# org.orchicon.runtime-base label and need no entry here.
# ORCHICON_RUNTIME_IMAGES=ghcr.io/beardedparrott/orchicon-runtime:gui

# --- Log management (rotating serve logs, docs/01 §Log Management) --------
# Controls the rotating file logger for `orchicon serve --detach`
# (default .dev/logs/orchicon.log). These are dev overrides; Settings →
# Defaults → Log management stores the live values in the DB and
# overrides these when set. Empty = built-in defaults (100MB / 24h / 7d / 7).
# ORCHICON_LOG_DIR=.dev/logs
# ORCHICON_LOG_MAX_SIZE_MB=100
# ORCHICON_LOG_ROLL_INTERVAL_HOURS=24
# ORCHICON_LOG_RETENTION_DAYS=7
# ORCHICON_LOG_MAX_FILES=7
