# Orchicon workflow-runtime GUI variant.
#
# Everything in the base image, plus the system libraries a headless GUI
# toolchain needs (Qt offscreen rendering via PySide6/PyQt, tkinter, and
# headless browser screenshots). It is built FROM the base image so it
# inherits the toolchain, the chowned-rootfs security model, and the
# org.orchicon.runtime-base label — the base is always part of this image.
#
# This file doubles as the reference template for building your own custom
# runtime images in the UI: FROM the base, USER root, install, re-chown,
# USER orchicon.
#
# BASE_IMAGE lets container.sh point local builds at the locally-built
# base (orchicon-runtime:local) while the release workflow defaults to
# the published base.
ARG BASE_IMAGE=ghcr.io/beardedparrott/orchicon-runtime:latest
FROM ${BASE_IMAGE}

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libgl1 libegl1 libfontconfig1 libxkbcommon0 libdbus-1-3 \
      libx11-6 libxext6 libxrender1 libxcb1 libxcb-cursor0 \
      xvfb xauth \
      python3-tk tk tcl \
 && rm -rf /var/lib/apt/lists/*
# Keep the writable-rootfs property: the runtime user must be able to
# write anywhere in the ephemeral filesystem (rootless installs).
RUN chown -R 1000:1000 /usr /opt /var 2>/dev/null || true

# ===================== RUNTIME CLI ADAPTERS =====================
# BOTH ADAPTERS ARE INSTALLED HERE, IN THE IMAGE, AND THAT IS A DELIBERATE REVERSAL.
#
# The base image says adapters are "deliberately NOT baked in — the daemon bind-mounts the host's
# installs". That works on a Linux host and ONLY on a Linux host: the mount hands the container a host
# path, and executing it requires the binary to be ELF. A Windows host mounts
# C:\Users\...\opencode.exe, which a Linux kernel cannot run, so container mode refused it before the
# container was even created ("the resolved adapter is a Windows executable"). Claude has the same
# problem from the other side: its transport is stdio to a process the supervisor spawns, so there is
# nothing to dial instead — the container must be able to EXECUTE it.
#
# Installing them here makes the container self-contained, which is the property that actually matters
# cross-platform: nothing about adapter handling now depends on what the host's binary format is, and
# Windows, macOS and Linux all reach container mode the same way.
#
# WHY THIS IS NOT REDISTRIBUTION: this file is a TEMPLATE, embedded in the orchicon binary and served
# read-only by the Runtime Images page. It is BUILT ON THE OPERATOR'S MACHINE, for their own licensed
# use, under their own credentials — Orchicon never builds it, publishes it, or hosts it. That is the
# same line this project already draws for host-installed adapters, and it is why only the BASE is
# published to ghcr.
#
# THE PACKAGES ARE THE PUBLISHED ONES, VERIFIED AGAINST THE npm REGISTRY rather than assumed:
#   @opencode/cli            2.2.2    bin: opencode, opencode2     (the 2.x line — "opencode-ai" is 1.19.5)
#   @anthropic-ai/claude-code 2.1.314 bin: claude
#
# THE VERSION IS PINNABLE, and that matters: `latest` is the factory default because a template cannot
# know which release an operator wants, but leaving it floating means an adapter silently changes
# behaviour on a rebuild months later. Pin it in the ARG and this is reproducible:
#
#   docker build --build-arg ORCHICON_OPENCODE_VERSION=2.2.2 ...
#
# ORCHICON_ADAPTERS can be set to "" to build without them (a container that runs no adapter CLI is a
# supported shape); the default installs both.
ARG ORCHICON_ADAPTERS="opencode claude"
ARG ORCHICON_OPENCODE_VERSION=latest
ARG ORCHICON_CLAUDE_VERSION=latest
RUN if [ -n "${ORCHICON_ADAPTERS}" ]; then \
      set -eux; \
      for a in ${ORCHICON_ADAPTERS}; do \
        case "$a" in \
          opencode) npm install -g "@opencode/cli@latest" ;; \
          claude)   npm install -g "@anthropic-ai/claude-code@latest" ;; \
          *) echo "unknown adapter in ORCHICON_ADAPTERS: $a" >&2; exit 1 ;; \
        esac; \
      done; \
      chown -R 1000:1000 /usr/local/lib/node_modules /usr/local/bin 2>/dev/null || true; \
    fi

USER orchicon
WORKDIR /home/orchicon
