#!/bin/sh
# ============================================================================
# orchicon-desktop - launcher for the Orchicon desktop app (Linux).
#
# WHY THIS FILE EXISTS AT ALL. WebKitGTK is a DYNAMIC-LINK dependency of the app
# binary: if libwebkit2gtk-4.0.so.37 is missing, the loader fails before main()
# runs, and the user gets
#
#     /usr/lib/orchicon/orchicon-desktop: error while loading shared libraries:
#     libwebkit2gtk-4.0.so.37: cannot open shared object file
#
# on a terminal — or, launched from a menu, NOTHING AT ALL. No in-process check
# can help, because there is no process. So the package installs this shell
# script as /usr/bin/orchicon-desktop and the real binary as
# /usr/lib/orchicon/orchicon-desktop, and the check happens HERE, in plain sh
# with no dependencies beyond ldconfig.
#
# The same check ships as the AppImage's AppRun, where the libraries are bundled
# and the message only appears if the bundle itself is broken.
# ============================================================================
set -eu

BIN="${ORCHICON_DESKTOP_BIN:-/usr/lib/orchicon/orchicon-desktop}"

webkit_present() {
  # ldconfig is the loader's own view, which is the only answer that matters.
  # WHEN IT IS ABSENT we return success and let exec fail: refusing to start on a
  # host that has a working webview (a container without ldconfig, say) would be a
  # worse bug than the one this check exists to report.
  command -v ldconfig >/dev/null 2>&1 || return 0
  # THE TWO ABI FAMILIES HAVE DIFFERENT SONAMEs, AND THEY ALWAYS HAVE:
  #   WebKitGTK 4.0  ->  libwebkit2gtk-4.0.so.37   (Ubuntu <= 23.10, Debian 12)
  #   WebKitGTK 4.1  ->  libwebkit2gtk-4.1.so.0    (Ubuntu >= 24.04, Fedora 40+, Arch)
  # The old pattern `libwebkit2gtk-4\.[01]\.so\.37` looked like it accepted both and
  # could never match 4.1 — `4.1.so.37` does not exist anywhere. On a 4.1-only distro
  # this launcher therefore reported "WebKitGTK not installed" for a system that had
  # it, and refused to start the app.
  ldconfig -p 2>/dev/null | grep -qE 'libwebkit2gtk-4\.0\.so\.37|libwebkit2gtk-4\.1\.so\.0'
}

if ! webkit_present; then
  cat >&2 <<'MSG'
Orchicon needs WebKitGTK, which is not installed on this system.
  missing: libwebkit2gtk-4.0.so.37  (Ubuntu <= 23.10 / Debian 12)
           libwebkit2gtk-4.1.so.0   (Ubuntu >= 24.04 / Fedora 40+ / Arch)
  fix:     sudo apt install libwebkit2gtk-4.0-37      (older Ubuntu/Debian)
           sudo apt install libwebkit2gtk-4.1-0       (Ubuntu >= 24.04)
           (Fedora: sudo dnf install webkit2gtk4.1   Arch: sudo pacman -S webkit2gtk)
           Or use the AppImage instead, which bundles it:
           https://github.com/beardedparrott/Orchicon/releases
MSG
  # A GUI launch has no terminal to read, so also try to say it in a dialog and
  # stay silent if no notifier is available.
  if command -v zenity >/dev/null 2>&1; then
    zenity --error --no-wrap --title "Orchicon cannot start" \
      --text "Orchicon needs WebKitGTK, which is not installed.\n\nFix: sudo apt install libwebkit2gtk-4.0-37\nOr use the AppImage, which bundles it." \
      >/dev/null 2>&1 || true
  fi
  exit 1
fi

exec "$BIN" "$@"
