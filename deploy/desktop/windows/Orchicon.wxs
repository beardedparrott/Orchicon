<?xml version="1.0" encoding="utf-8"?>
<!--
  Orchicon.msi - the Windows installer.

  WHY AN MSI AT ALL. Wails emits an NSIS installer, and an NSIS .exe cannot be
  deployed by the tooling a Windows estate actually uses: Intune, SCCM, Group
  Policy and `msiexec /qn` all speak MSI, and none of them can drive an NSIS
  wizard. The NSIS installer stays (it is the desktop app's own installer, and
  `install.ps1 -Desktop` uses it); this packages the WHOLE product - CLI, TUI and
  desktop app - for the managed case.

  THE SHAPE, and each choice is a consequence of something measured:

  * PER-USER, NO ELEVATION (`Scope="perUser"`). Orchicon's whole model is "the
    plane and its services are host processes of the user who installs them",
    with a per-user data directory. A per-machine install (Program Files, an
    elevated service account) would put the BINARIES under one identity and run
    the SERVICES under another - the one arrangement the product does not
    support. Per-user also means no UAC prompt.

  * THE SERVICE BINARIES ARE NOT IN HERE (542 MB measured: otelcol 293, loki
    105, tempo 74, postgres 34, vm 24, nats 16). Bundling them would make a
    ~750 MB MSI that still has to pull multi-GB container images, and it would
    version-lock the services to the installer. `orchicon install` acquires them
    at setup time, which is what the one-line ps1 install does today.

  * THE SETUP RUNS `orchicon install` IN A VISIBLE CONSOLE, from the last step.
    NOT a custom action that talks to the operator: an MSI custom action has no
    console, so `installIsInteractive()` is false and any prompt writes into
    nothing and blocks for ever - the hazard install.ps1 documents at length.
    Delegating also means the MSI cannot drift from the CLI's notion of
    "installed": there is one implementation, and it is not here.

  * THE WIZARD'S ANSWERS TRAVEL AS ENVIRONMENT. `INSTANCE` and `RUNTIMEIMAGES`
    are PUBLIC properties (settable on the command line for `msiexec /qn`) and
    are handed to the wrapper as %1/%2. RUNTIMEIMAGES is the variable added in
    the same change - without it a wizard's multi-select was silently discarded
    by the non-interactive path, so an install fetched none of what was ticked.
-->
<!--
  BUILDING THIS FILE NEEDS TWO THINGS ON THE COMMAND LINE, and neither is implied by
  anything inside it:

      wix build Orchicon.wxs -arch x64 -ext WixToolset.UI.wixext/5.0.2

  * -ext ... : ui:WixUI is an EXTENSION element. The xmlns below makes the file
    well-formed and does NOT enable it (WIX0200).
  * the /5.0.2 suffix : the extension is restored from NuGet, and a bare package
    name does not resolve ("error WIX0144: The extension 'WixToolset.UI.wixext'
    could not be found"). It is versioned to match WIX_VERSION in the Makefile.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Orchicon"
           Manufacturer="Orchicon"
           Version="$(var.Version)"
           UpgradeCode="DF9438BD-B311-5C12-A1D2-EB415DF74F2D"
           Scope="perUser"
           Compressed="yes"
           InstallerVersion="500">

    <!-- A MAJOR UPGRADE REPLACES IN PLACE. Without this an install over an older
         version leaves two ARP entries and two sets of files, and the second
         `orchicon install` then has to guess which binary is "the" plane. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Orchicon is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- PUBLIC PROPERTIES = the unattended surface. All-uppercase ids are
         settable from the command line, so an enterprise deployment is
             msiexec /i Orchicon.msi /qn INSTANCE=prod RUNTIMEIMAGES=1 SKIPSETUP=1
         and needs no wizard. -->
    <Property Id="INSTANCE" Value="dev" />
    <!-- NO Value: an empty Value attribute is illegal (WIX0006), and it must default to
         UNSET rather than "none" - the wrapper leaves the env var alone when %2 is
         empty, which is what keeps the interactive runtime-image prompt alive. A
         default of "none" would be an ANSWER, and the prompt would be skipped.
         Secure="yes" declares a property that carries a value from the UI or the
         command line without giving it one (and without being ignored - WIX1006). -->
    <!-- DEFAULTS TO "none", WHICH IS NOW THE WIZARD'S ANSWER RATHER THAN A SUPPRESSION.
         It used to be intentionally UNSET so the setup's own console prompt stayed alive. The
         console prompt is gone - the ImagesDlg page asks - so leaving it unset would produce
         a dangling runtime-image flag with no value, which the parser correctly rejects.
         "none" is also what the page defaults to: a project starts in execution_mode=local, so
         someone who never opts in needs no image at all. -->
    <Property Id="RUNTIMEIMAGES" Value="none" Secure="yes" />
    <Property Id="SKIPSETUP" Value="0" />
    <!-- DESTROY MY DATA ON UNINSTALL. Unset (= 0) keeps the database cluster, the attachment blobs
         and the secrets KEK, which is the safe default: an uninstall removes the SOFTWARE, and the
         operator's data is what a reinstall reuses. 1 runs the uninstall verb WITH THE PURGE FLAG,
         which is IRREVERSIBLE and is the only path that removes the cluster or the KEK.

         Public (all-uppercase) so it survives into the execute sequence and can be passed on the
         command line for an unattended nuke:
           msiexec /x Orchicon.msi /qn PURGEDATA=1 -->
    <Property Id="PURGEDATA" Value="0" Secure="yes" />
    <!-- THE WIZARD'S OWN ANSWERS. Public (all-uppercase) so they survive into the execute
         sequence AND can be set on the command line for an unattended install. Empty means
         "use this instance's default", which is what the port resolver already does with an
         absent pin, so blank fields need no special case. -->
    <Property Id="CONTROLPORT" Secure="yes" />
    <Property Id="POSTGRESPORT" Secure="yes" />
    <Property Id="LOKIPORT" Secure="yes" />
    <Property Id="TEMPOPORT" Secure="yes" />
    <!-- THE IMAGE CHECKBOXES AND THE MODE RADIO. The three boxes are individual selections; the
         radio chooses between "none" and "choose". RUNTIMEIMAGES is what the install reads, and
         it is written from these by the publish chain on Next. -->
    <Property Id="IMAGESMODE" Value="none" Secure="yes" />
    <Property Id="IMAGE1" Secure="yes" />
    <Property Id="IMAGE2" Secure="yes" />
    <Property Id="IMAGE3" Secure="yes" />
    <!-- WHERE THE WIZARD'S QUESTIONS GO. The default (0) means "ask me": the setup step opens
         its own console and prompts. Set SKIPCONFIG=1 for an unattended run, where the values
         above must already be filled in. -->
    <Property Id="SKIPCONFIG" Value="0" />

    <Property Id="ARPPRODUCTICON" Value="OrchiconIcon" />
    <!-- ARPNOMODIFY IS NOT DECLARED HERE. WixUI_InstallDir already defines it, and a
         second declaration is a hard error:
             error WIX0091: Duplicate Property with identifier 'ARPNOMODIFY' found.
         The UI set gives it, which is also the right value for this package. -->
    <Property Id="ARPURLINFOABOUT" Value="https://orchicon.dev" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <!-- THE LICENSE PAGE TEXT IS *NOT* A PROPERTY. It is a BUILD-TIME variable:
             wix build ... -d WixUILicenseRtf=<path to the .rtf>
         The UI extension reads it then, embeds the file as a Binary and points the
         license control at that Binary. Declaring
             <Property Id="WixUILicenseRtf" Value="...\LICENSE.rtf" />
         looks like it should work and does NOTHING - the wizard kept rendering WiX's
         built-in placeholder, which is lorem ipsum. Reported from a real install:
         "the windows installer has some default text in there".
         Every build site now passes the variable; cmd/orchicon/windows_msi_test.go
         fails any of them that stops. -->

    <!-- THE WIZARD ART, INSTEAD OF WIX'S OWN.
         Without these two variables the WixUI dialogs fall back to WiX's default
         bitmaps - a red/black pattern with nothing to do with Orchicon - and on the
         reporter's machine that art visibly FLICKERED as the dialog repainted.
         Sizes are fixed by the dialog layout, not by taste:
             WixUIBannerBmp   493 x 58    the strip across the top of every page
             WixUIDialogBmp   493 x 312   the panel on the welcome/finish pages
         The files are generated from build/appicon.png by
         deploy/desktop/windows/make-wizard-bitmaps.py and COMMITTED (the same
         treatment as the .ico), so packaging never needs Python or a font. -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.SourceDir)\wizard-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.SourceDir)\wizard-dialog.bmp" />

    <!-- FIRST-RUN DEFAULTS FOR THE WIZARD'S FIELDS, so a blank box means the instance's
         documented port rather than nothing. A re-install must NOT clobber a value already
         supplied on the command line - hence the "NOT Installed" guard on the publish. -->
    <Property Id="WIX_ORCHICON_DEFAULTS_SET" Value="0" />

    <Icon Id="OrchiconIcon" SourceFile="$(var.SourceDir)\orchicon-desktop.ico" />

    <!-- PER-USER LOCATIONS ONLY. LocalAppDataFolder and the per-user Program Menu
         need no elevation; ProgramFilesFolder and the machine Program Menu would
         need both, and would put the binaries somewhere the installing user may
         not be able to write. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Orchicon" />
      </Directory>
    </StandardDirectory>

    <Feature Id="CliFeature" Title="Orchicon (plane, CLI and TUI)" Level="1"
             Description="orchicon.exe and orch.exe: the control plane, the CLI and the TUI.">
      <ComponentGroupRef Id="CliComponents" />
    </Feature>

    <Feature Id="DesktopFeature" Title="Orchicon desktop app" Level="1"
             Description="The GUI client. Optional - the web UI at the plane's URL does everything it does.">
      <ComponentGroupRef Id="DesktopComponents" />
    </Feature>

    <ComponentGroup Id="CliComponents" Directory="INSTALLFOLDER">
      <!-- KeyPath on the FILE (not the directory): per-user installs cannot use a
           directory as a key path, and a registry key path would add state to
           clean up for no benefit. -->
      <Component Id="OrchiconExe" Guid="*">
        <File Id="OrchiconExeFile" Source="$(var.SourceDir)\orchicon.exe" KeyPath="yes" />
      </Component>
      <Component Id="OrchExe" Guid="*">
        <File Id="OrchExeFile" Source="$(var.SourceDir)\orch.exe" KeyPath="yes" />
      </Component>
      <Component Id="ReadmeFile" Guid="*">
        <File Id="ReadmeTxtFile" Source="$(var.SourceDir)\README-WINDOWS.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DesktopComponents" Directory="INSTALLFOLDER">
      <Component Id="DesktopExe" Guid="*">
        <File Id="DesktopExeFile" Source="$(var.SourceDir)\orchicon-desktop.exe" KeyPath="yes">
          <!-- Advertise="no" is REQUIRED for a per-user shortcut: an advertised
               shortcut is a machine-wide feature and fails without elevation. -->
          <Shortcut Id="StartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="Orchicon"
                    Description="Orchicon desktop app"
                    Advertise="no"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="OrchiconIcon" />
          <Shortcut Id="DesktopShortcut"
                    Directory="DesktopFolder"
                    Name="Orchicon"
                    Description="Orchicon desktop app"
                    Advertise="no"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="OrchiconIcon" />
        </File>
        <!-- The shortcuts are removed by their parent component's uninstall, so no
             explicit RemoveFolder is needed for them. -->
      </Component>
    </ComponentGroup>

    <!-- ===================== THE SETUP HAND-OFF =============================
         IT RUNS THE INSTALLED EXE DIRECTLY. No `cmd.exe`, no `start`, no wrapper script, no
         path assembly, no quoted arguments - `FileRef` names the File row, so MSI writes the
         command line itself from the file it just installed.

         THE HISTORY IS THE REASON, and every step of it was a quoting bug:

           "[#SetupCmdFile]" "[INSTANCE]" "[RUNTIMEIMAGES]"   → RUNTIMEIMAGES is unset BY
             DESIGN (an empty default would skip the setup's own image prompt), so that token
             became an empty quoted string. Crossing MSI's command-line building, `cmd /c` and
             `start`, a quote was eaten per hop and cmd was handed the wrapper's PATH as a
             COMMAND NAME: "'...orchicon-setup.cmd"  "dev" "' is not recognized..."
           ...then a bare `orchicon-setup.cmd` from the working directory, which fixed the
             quoting but kept three processes and a file to get wrong.

         Now there is nothing left to get wrong: one process, and one argument -
         "install" plus the instance flag - which has no empty-value case.

         The instance FLAG rather than an environment variable, because a custom action cannot set
         the child's environment. It is a plain word, so it needs no quoting.

         THE CONSOLE. A custom action has none, and the setup prompts. `orchicon install`
         allocates its OWN console (CREATE_NEW_CONSOLE, see cmd/orchicon/console_windows.go)
         and re-executes itself - which is why this action no longer needs `start` to
         manufacture a visible window.

         Return="asyncNoWait": the re-exec is immediate, but the install behind it is minutes
         of downloads and prompts. Holding InstallFinalize open for that would make the
         wizard look hung; the install is idempotent and resumable, so there is nothing to
         wait for.

         Impersonate="yes": it runs AS THE INSTALLING USER. Everything it starts (the plane,
         postgres, nats) must belong to that user.

         SKIPSETUP=1 remains the unattended opt-out (binaries only), and the Burn bundle
         passes it because the bundle gives the operator its own UI. -->
    <CustomAction Id="LaunchSetup"
                  FileRef="OrchiconExeFile"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait"
                  ExeCommand="install --non-interactive --instance [INSTANCE] --port ORCHICON_CONTROL_PORT=[CONTROLPORT] --port ORCHICON_POSTGRES_PORT=[POSTGRESPORT] --port ORCHICON_LOKI_PORT=[LOKIPORT] --port ORCHICON_TEMPO_PORT=[TEMPOPORT] --runtime-images [RUNTIMEIMAGES]" />

    <!-- ===================== THE UNINSTALL ==============================
         AN UNINSTALL MUST TAKE THE SERVICES WITH IT, and until now it took nothing: LaunchSetup is
         conditioned on NOT REMOVE, so uninstalling removed the binaries and left a live services
         supervisor, a live plane, postgres and nats holding their ports, and the instance state
         directory. The operator's report was "the past two uninstall/reinstalls don't start the
         services and serve up fully automatically" — the REINSTALL inherited that orphan, and the
         port conflict it caused was (until this same change) fatal before cleanup could run.

         IT RUNS THE INSTALLED EXE, exactly like LaunchSetup, for the same reason: FileRef makes MSI
         write the command line from the file it is removing, so there is no quoting to get wrong.

         Return="asyncNoWait" during INSTALLVALIDATE-adjacent removal is deliberately NOT used: this
         must FINISH before the binaries disappear, because it is the thing that stops them. It runs
         at InstallFinalize on the REMOVE path, which is after the deferred script has done its work
         and before the process exits.

         IT CANNOT RUN AFTER THE FILES ARE GONE, so it is sequenced before RemoveFiles by using
         InstallFinalize's position (RemoveFiles precedes it). A missing binary — a broken install —
         is a no-op rather than a failed uninstall: the operator asked to remove the product, and a
         missing exe must not block that. -->
    <!-- TWO ACTIONS, ONE PER ANSWER, because MSI expands properties textually:  [PURGEDATA] would
         interpolate a bare "1" as a positional argument, which the parser would then read as an
         instance name. Two command lines with two conditions is unambiguous, and it keeps the flag
         that destroys data visible in the source rather than inferred from a property value.

         ALL INSTANCES, NOT [INSTANCE], AND THAT IS A CORRECTNESS FIX.

         It used to pass the instance the wizard chose. But MSI properties are SESSION-SCOPED: the
         value set in the install session does not exist in the uninstall session, so on uninstall
         [INSTANCE] fell back to its default ("dev") from the Property table. An operator who chose
         prod would have had `orchicon uninstall —instance dev` run instead — removing the wrong
         instance, or nothing at all, while reporting success.

         —all is also the right SCOPE rather than a papering-over. A machine can hold several
         instances (dev, prod, test — each with its own data dir, ports and copy of the service
         binaries), and more can be created by hand with `orchicon install —instance <name>`. The
         uninstall verb ENUMERATES the instance directories rather than trusting a remembered
         property, so it reaches instances this MSI never created. And it must, because this action
         is about to delete orchicon.exe: an instance whose services are still running after that
         has no CLI to stop them, which is worse than not uninstalling at all.

         Per-instance granularity is the CLI's job, and it already exists:
             orchicon uninstall dev              remove one instance, keep its data
             orchicon uninstall dev —purge      remove one instance and its data -->
    <CustomAction Id="LaunchUninstall"
                  FileRef="OrchiconExeFile"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore"
                  ExeCommand="uninstall --all" />
    <CustomAction Id="LaunchUninstallPurge"
                  FileRef="OrchiconExeFile"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore"
                  ExeCommand="uninstall --all --purge" />

    <InstallExecuteSequence>
      <!-- REMOVE ONLY: the mirror of LaunchSetup's NOT REMOVE. -->
      <Custom Action="LaunchUninstall" After="InstallFinalize" Condition="REMOVE=&quot;ALL&quot; AND SKIPSETUP &lt;&gt; &quot;1&quot; AND PURGEDATA &lt;&gt; &quot;1&quot;" />
      <Custom Action="LaunchUninstallPurge" After="LaunchUninstall" Condition="REMOVE=&quot;ALL&quot; AND SKIPSETUP &lt;&gt; &quot;1&quot; AND PURGEDATA=&quot;1&quot;" />
      <!-- NOT REMOVE: never on uninstall. NOT Installed is deliberately absent: a repair or
           an upgrade should re-converge, and `orchicon install` is idempotent.

           AFTER="InstallFinalize" - AN IMMEDIATE ACTION PLACED AFTER "InstallFiles" RUNS TOO
           EARLY. MSI walks the execute sequence twice: an immediate pass that BUILDS the
           script, and a deferred pass that runs it and copies the files. An immediate action
           runs in the first, when the payload is merely scheduled - which is how the old
           hand-off came to launch before the wrappper existed. InstallFinalize is after the
           deferred script has completed. -->
      <Custom Action="LaunchSetup" After="InstallFinalize" Condition="NOT REMOVE AND SKIPSETUP &lt;&gt; &quot;1&quot;" />
    </InstallExecuteSequence>

    <!-- ===================== THE WIZARD'S OWN PAGES =====================
         INSIDE <Package>, NEXT TO <ui:WixUI>, AND THAT PLACEMENT IS THE FIX.
         These pages first lived in a separate source file as a <Fragment><UI>. WiX compiled
         that file happily - it even reported the schema errors I was chasing - and then
         DROPPED the whole thing at link: the finished MSI contained none of its dialogs and
         none of its text, while every property defined here in <Package> shipped. A fragment
         is not connected to the package's UI, so the dialogs were unreachable and pruned.

         A dialog no path reaches is the "seam nothing calls" failure, and it is SILENT: the
         build is green, the package installs, and the wizard is unchanged.

         THE FLOW:
             WelcomeDlg -> InstanceDlg -> PortsDlg -> ImagesDlg -> VerifyReadyDlg
         WelcomeDlgNext is overridden at Order="2" (WixUI's own is 1, pointing at the licence
         page). InstanceDlg's Back goes to the licence, and the licence's Next comes back here,
         so the terms are still shown before anything is written - re-sequenced, not skipped.

         THE CONDITION IS AN ATTRIBUTE IN WIX v4. WiX v3 took it as the element's text; v4
         rejects that with "WIX0400: The Publish element contains illegal inner text". -->
    <UI>
      <!-- ===================== THE UNINSTALL'S DATA QUESTION =====================
           THE OPERATOR: "We should have options in the uninstall of the MSI to allow people to remove all
           data if they want or just infrastructure."

           This is that page. It is reached ONLY on a full remove (REMOVE="ALL"), so an install, a repair
           and a "change" never see it; and it is published at Order="2" so it wins over WixUI's own
           MaintenanceWelcomeDlg -> MaintenanceTypeDlg hop, which a plain ARP uninstall has no use for
           (there is nothing to modify: the operator already chose Remove).

           THE DEFAULT IS KEEP, deliberately. An uninstall removes the SOFTWARE; the database cluster,
           the attachments and the secrets key are the operator's, they are what a reinstall reuses, and
           destroying them by default would make a routine "remove and reinstall" catastrophic. The
           destructive choice is one explicit radio click away, and it says what it destroys.

           IT WRITES PURGEDATA, which the two uninstall actions read (see LaunchUninstall /
           LaunchUninstallPurge). A RadioButtonGroup rather than a bare checkbox because two exclusive
           options are what this is, and a radio makes the safe one visibly selected. -->
      <Dialog Id="RemoveOptionsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Remove [ProductName]" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Everything Orchicon is running will be stopped first." />

        <Control Id="DataRadio" Type="RadioButtonGroup" X="20" Y="56" Width="330" Height="80"
                 Property="PURGEDATA">
          <RadioButtonGroup Property="PURGEDATA">
            <RadioButton Value="0" X="0" Y="0" Width="330" Height="18" Text="Keep my data (recommended)" />
            <RadioButton Value="1" X="0" Y="22" Width="330" Height="18" Text="Also destroy my data - CANNOT be undone" />
          </RadioButtonGroup>
        </Control>

        <!-- ONE NOTE, NOT TWO CONDITIONAL ONES. A control whose visibility follows a property needs
             Publish/Hide events in WiX v4+ (a Condition CHILD element is rejected outright), and an
             installer is the last place to add conditional UI state for a cosmetic gain: the two
             outcomes are short enough to state together, and a wizard page that always renders is a
             wizard page that cannot render wrong. -->
        <Control Id="DataNote" Type="Text" X="36" Y="96" Width="316" Height="66" Transparent="yes" NoPrefix="yes"
                 Text="Keep (recommended): leaves the database (projects, workers, conversations, executions), your attachments, and the key that decrypts your secrets, so a reinstall reuses them.  Destroy: deletes the database, your attachments AND that key, so the secrets can never be decrypted again. There is no undo." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="MaintenanceWelcomeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- REMOVE="ALL" ONLY. A "change" (repair, or the maintenance type page) must keep WixUI's own
           flow, so this publish is conditioned rather than unconditional. -->
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="RemoveOptionsDlg" Order="2" Condition="REMOVE=&quot;ALL&quot;" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstanceDlg" Order="2" />
      <Publish Dialog="InstanceDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" Order="2" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstanceDlg" Order="2" Condition="LicenseAccepted = &quot;1&quot;" />

      <Dialog Id="InstanceDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Which instance?" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Each instance is a whole stack: its own plane, ports, services and data." />

        <Control Id="InstanceRadio" Type="RadioButtonGroup" X="20" Y="60" Width="330" Height="90"
                 Property="INSTANCE">
          <RadioButtonGroup Property="INSTANCE">
            <RadioButton Value="dev" X="0" Y="0" Width="330" Height="18" Text="dev - for trying it out (the default)" />
            <RadioButton Value="test" X="0" Y="22" Width="330" Height="18" Text="test - for a second stack on this machine" />
            <RadioButton Value="prod" X="0" Y="44" Width="330" Height="18" Text="prod - this machine's real instance" />
          </RadioButtonGroup>
        </Control>

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="PortsDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ===================== PORTS =====================
           The two the installer has always ASKED about. Everything else in the port table is
           derived from the instance (and offset per instance), so putting sixteen fields here
           would be a wall of numbers for values nobody wants to change. -->
      <Dialog Id="PortsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Host ports" />
        <!-- HEIGHT 30, NOT 15: this sentence wraps to two lines and the second was being cut off
             ("... is reported during se"). Eight dialogs in WixUI use 15 because their text is one
             line; ours is not. -->
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="30" Transparent="yes" NoPrefix="yes"
                 Text="Leave a box empty to use this instance's default. A port already in use is reported during setup." />

        <Control Id="ControlPortLabel" Type="Text" X="20" Y="62" Width="200" Height="15" NoPrefix="yes"
                 Text="Control plane (web UI + API) - dev 8080 / test 8091 / prod 8092:" />
        <Control Id="ControlPortEdit" Type="Edit" X="230" Y="60" Width="70" Height="17"
                 Property="CONTROLPORT" Text="[CONTROLPORT]" />

        <Control Id="PostgresPortLabel" Type="Text" X="20" Y="88" Width="200" Height="15" NoPrefix="yes"
                 Text="PostgreSQL - dev 5432 / test 5433 / prod 5434:" />
        <Control Id="PostgresPortEdit" Type="Edit" X="230" Y="86" Width="70" Height="17"
                 Property="POSTGRESPORT" Text="[POSTGRESPORT]" />

        <!-- THE TWO MOST LIKELY TO COLLIDE WITH SOMETHING ALREADY INSTALLED. Loki and Tempo are
             where an existing Grafana stack usually already sits, so they are offered; the other
             nine in the table (NATS, OTLP gRPC/HTTP, Tempo's two receivers, VictoriaMetrics,
             collector health) stay derived per instance. A wall of thirteen fields would bury
             the four that matter. -->
        <Control Id="LokiPortLabel" Type="Text" X="20" Y="114" Width="200" Height="15" NoPrefix="yes"
                 Text="Loki (logs) - dev 3100 / test 3101 / prod 3102:" />
        <Control Id="LokiPortEdit" Type="Edit" X="230" Y="112" Width="70" Height="17"
                 Property="LOKIPORT" Text="[LOKIPORT]" />

        <Control Id="TempoPortLabel" Type="Text" X="20" Y="140" Width="200" Height="15" NoPrefix="yes"
                 Text="Tempo (traces) - dev 3200 / test 3201 / prod 3202:" />
        <Control Id="TempoPortEdit" Type="Edit" X="230" Y="138" Width="70" Height="17"
                 Property="TEMPOPORT" Text="[TEMPOPORT]" />

        <Control Id="PortsHint" Type="Text" X="20" Y="170" Width="330" Height="50" Transparent="yes"
                 Text="Blank means this instance's default. The remaining ports (NATS, telemetry, metrics) are offset per instance, so two instances never collide; everything bound is written down and printed at the end of setup." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstanceDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="ImagesDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ===================== RUNTIME IMAGES =====================
           Optional, and defaulted OFF: a project starts in execution_mode=local, so someone who
           never opts in needs no image at all. Pulling multi-GB layers up front made every
           install pay for a feature it might never use. -->
      <Dialog Id="ImagesDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Runtime images" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Optional container images for workflow runs. Downloading several GB now is not required." />

        <!-- REAL CHECKBOXES, WHICH REAL CHECKBOXES, WHICH THE runtime-images LIST FORM WAS BUILT FOR ALL ALONG.
             Two bulk answers (none / all) covered the extremes and nothing in between, and "some"
             is the common case: someone who wants the base image without two others' worth of GB.
             Each box appends its number to RUNTIMEIMAGES; none ticked sends "none", which is what
             the install already understands. -->
        <Control Id="ImagesNone" Type="RadioButtonGroup" X="20" Y="58" Width="330" Height="44"
                 Property="IMAGESMODE">
          <RadioButtonGroup Property="IMAGESMODE">
            <RadioButton Value="none" X="0" Y="0" Width="330" Height="18" Text="None - local execution only (recommended, and the default)" />
            <RadioButton Value="choose" X="0" Y="22" Width="330" Height="18" Text="Choose individual images:" />
          </RadioButtonGroup>
        </Control>

        <Control Id="Image1" Type="CheckBox" X="40" Y="112" Width="310" Height="17"
                 Property="IMAGE1" CheckBoxValue="1" Text="runtime base - the workflow runner everything builds on (~1 GB)" />
        <Control Id="Image2" Type="CheckBox" X="40" Y="134" Width="310" Height="17"
                 Property="IMAGE2" CheckBoxValue="1" Text="runtime GUI - adds a browser for web UI work (+150 MB)" />
        <Control Id="Image3" Type="CheckBox" X="40" Y="156" Width="310" Height="17"
                 Property="IMAGE3" CheckBoxValue="1" Text="runtime dev - adds python, node and common CLIs (+1.5-2.5 GB)" />

        <!-- Y=186, CLEAR OF THE LAST CHECKBOX AT 156+17=173. It used to sit at 150 and printed
             straight through it, which is the "graphical glitches" that made the image list
             unreadable. -->
        <Control Id="ImagesHint" Type="Text" X="20" Y="186" Width="330" Height="34" Transparent="yes"
                 Text="Each variant builds on runtime base, so ticking one includes it. Images can be added at any time from Settings, Runtime images - nothing here is final." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="PortsDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <!-- THE CHECKBOXES COMPOSE THE VALUE THE INSTALL READS. Without these publishes they
               are decoration: three ticked boxes that never reach RUNTIMEIMAGES would install
               nothing and report nothing wrong - the "page whose answer does not reach the
               property" failure this wizard exists to avoid.

               Each publish APPENDS its number with a leading comma ("[~]" appends), and the
               first one is guarded on the property being empty-or-none so a sequence cannot
               start with a stray comma. "none" and "[]" are both empty to the install, and
               ValueToInstall translates a ticked-but-empty selection to none.

               ORDER MATTERS: the reset to "none" runs first, then the appends, then the fixup. -->
          <Publish Property="RUNTIMEIMAGES" Value="none" Order="1" Condition="IMAGESMODE = &quot;none&quot;" />
          <Publish Property="RUNTIMEIMAGES" Value="[]" Order="2" Condition="IMAGESMODE = &quot;choose&quot;" />
          <Publish Property="RUNTIMEIMAGES" Value="1" Order="3" Condition="IMAGESMODE = &quot;choose&quot; AND IMAGE1 = &quot;1&quot; AND RUNTIMEIMAGES = &quot;[]&quot;" />
          <Publish Property="RUNTIMEIMAGES" Value="[~]1" Order="4" Condition="IMAGESMODE = &quot;choose&quot; AND IMAGE1 = &quot;1&quot; AND RUNTIMEIMAGES &lt;&gt; &quot;[]&quot;" />
          <Publish Property="RUNTIMEIMAGES" Value="2" Order="5" Condition="IMAGESMODE = &quot;choose&quot; AND IMAGE2 = &quot;1&quot; AND (RUNTIMEIMAGES = &quot;[]&quot; OR RUNTIMEIMAGES = &quot;[]&quot;)" />
          <Publish Property="RUNTIMEIMAGES" Value="[~]2" Order="6" Condition="IMAGESMODE = &quot;choose&quot; AND IMAGE2 = &quot;1&quot; AND RUNTIMEIMAGES &lt;&gt; &quot;[]&quot; AND RUNTIMEIMAGES &lt;&gt; &quot;1&quot;" />
          <Publish Property="RUNTIMEIMAGES" Value="[~]2" Order="7" Condition="IMAGESMODE = &quot;choose&quot; AND IMAGE2 = &quot;1&quot; AND RUNTIMEIMAGES = &quot;1&quot;" />
          <Publish Property="RUNTIMEIMAGES" Value="3" Order="8" Condition="IMAGESMODE = &quot;choose&quot; AND IMAGE3 = &quot;1&quot; AND RUNTIMEIMAGES = &quot;[]&quot;" />
          <Publish Property="RUNTIMEIMAGES" Value="[~]3" Order="9" Condition="IMAGESMODE = &quot;choose&quot; AND IMAGE3 = &quot;1&quot; AND RUNTIMEIMAGES &lt;&gt; &quot;[]&quot;" />
          <!-- A ticked "choose" with NOTHING selected is "none", not "[]" - the install must never
               receive a value it has to guess at. -->
          <Publish Property="RUNTIMEIMAGES" Value="none" Order="10" Condition="RUNTIMEIMAGES = &quot;[]&quot;" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="20" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>

    <ui:WixUI Id="WixUI_InstallDir" />
  </Package>
</Wix>
