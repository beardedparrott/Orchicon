<?xml version="1.0" encoding="utf-8"?>
<!--
  OrchiconConfig.wxs - the wizard's OWN pages: instance, ports, runtime images.

  WHY THESE EXIST. The setup used to ask these in a console window it opened itself, which is
  not "an installer" — it is an installer that hands you off to a shell. Everything the setup
  needs to know is asked HERE, in the wizard, and travels to the install as MSI properties.
  There is no console at any point.

  THE PROPERTIES ARE THE CONTRACT. Each control writes one PUBLIC property, and the custom
  action passes those to `orchicon install` as flags: the instance, one port per pin, and the image choice. A page whose answer does not reach the property is decoration; every
  property here is asserted in cmd/orchicon/windows_msi_test.go.

  THIS FILE IS INCLUDED BY Orchicon.wxs (included by), so the dialogs and the package's own
  definitions stay in one compiled unit — WiX resolves dialog references across the merged
  fragments, and the UI sequence is overridden in Orchicon.wxs where the rest of the flow is.
-->
<!-- WIX0048: an INCLUDED file is rooted at <Include>, not <Wix>. WiX rejects a <Wix> document
     element here because the include is spliced INTO the parent document, and two document
     elements would make an incorrectly structured document. -->
<Include xmlns="http://wixtoolset.org/schemas/v4/wxs"
         xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Fragment>
    <!-- ===================== WHICH INSTANCE =====================
         A whole stack: its own plane, ports, host services and data. Defaults to dev, which is
         what the CLI and the one-line install default to, so the wizard and the script agree. -->
    <UI>
      <Dialog Id="InstanceDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Which instance?" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Each instance is a whole stack: its own plane, ports, services and data." />

        <Control Id="InstanceRadio" Type="RadioButtonGroup" X="20" Y="60" Width="330" Height="90"
                 Property="INSTANCE">
          <RadioButtonGroup Property="INSTANCE">
            <RadioButton Value="dev" X="0" Y="0" Width="330" Height="18" Text="dev — for trying it out (the default)" />
            <RadioButton Value="test" X="0" Y="22" Width="330" Height="18" Text="test — for a second stack on this machine" />
            <RadioButton Value="prod" X="0" Y="44" Width="330" Height="18" Text="prod — this machine's real instance" />
          </RadioButtonGroup>
        </Control>

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="PortsDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ===================== PORTS =====================
           The two the installer has always ASKED about. Everything else in the port table is
           derived from the instance (and offset per instance), so putting sixteen fields here
           would be a wall of numbers for values nobody wants to change. -->
      <Dialog Id="PortsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Host ports" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Leave a box empty to use this instance's default. A port already in use is reported during setup." />

        <Control Id="ControlPortLabel" Type="Text" X="20" Y="62" Width="200" Height="15" NoPrefix="yes"
                 Text="&amp;Control plane (web UI + API):" />
        <Control Id="ControlPortEdit" Type="Edit" X="230" Y="60" Width="70" Height="17"
                 Property="CONTROLPORT" Text="[CONTROLPORT]" />

        <Control Id="PostgresPortLabel" Type="Text" X="20" Y="88" Width="200" Height="15" NoPrefix="yes"
                 Text="&amp;PostgreSQL:" />
        <Control Id="PostgresPortEdit" Type="Edit" X="230" Y="86" Width="70" Height="17"
                 Property="POSTGRESPORT" Text="[POSTGRESPORT]" />

        <Control Id="PortsHint" Type="Text" X="20" Y="120" Width="330" Height="60" Transparent="yes"
                 Text="Orchicon offsets every other port (NATS, telemetry, traces, logs, metrics) per instance, so two instances never collide. The values bound are written down and printed at the end of setup." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstanceDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="ImagesDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ===================== RUNTIME IMAGES =====================
           Optional, and defaulted OFF: a project starts in execution_mode=local, so someone who
           never opts in needs no image at all. Pulling multi-GB layers up front made every
           install pay for a feature it might never use. -->
      <Dialog Id="ImagesDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Runtime images" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Optional container images for workflow runs. Downloading several GB now is not required." />

        <Control Id="ImagesNone" Type="RadioButtonGroup" X="20" Y="62" Width="330" Height="80"
                 Property="RUNTIMEIMAGES">
          <RadioButtonGroup Property="RUNTIMEIMAGES">
            <RadioButton Value="none" X="0" Y="0" Width="330" Height="18" Text="None — local execution only (recommended, and the default)" />
            <RadioButton Value="all" X="0" Y="22" Width="330" Height="18" Text="All published images — downloads several GB now" />
          </RadioButtonGroup>
        </Control>

        <Control Id="ImagesHint" Type="Text" X="20" Y="150" Width="330" Height="60" Transparent="yes"
                 Text="Images can be added at any time from Settings → Runtime images, so nothing here is final." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="PortsDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Include>
