{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "Tokens by model",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "sum(orchicon_tokens_consumed) by (model)", "range": true, "instant": false }
      ],
      "fieldConfig": {
        "defaults": { "custom": {}, "unit": "short" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Cost by model (USD)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "sum(orchicon_cost_usd) by (model)", "range": true, "instant": false }
      ],
      "fieldConfig": {
        "defaults": { "custom": {}, "unit": "currencyUSD" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Outbox relay lag",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "orchicon_outbox_lag", "range": true, "instant": false }
      ],
      "fieldConfig": {
        "defaults": { "custom": {}, "unit": "short" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "type": "logs",
      "title": "Control plane logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "{orchicon_tenant_id=\"tnt_dev\"}", "queryType": "range", "range": true }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true
      }
    },
    {
      "type": "table",
      "title": "Recent traces",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        { "refId": "A", "queryType": "traceql", "query": "{}", "limit": 20, "tableType": "traces" }
      ],
      "fieldConfig": {
        "defaults": { "custom": {} },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Start time" }]
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["orchicon"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Orchicon",
  "uid": "orchicon-dashboard",
  "version": 1
}
