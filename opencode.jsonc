{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {},
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp"
      ],
      "enabled": true
    },
    "orchicon": {
      "type": "local",
      "command": [
        "docker",
        "exec",
        "-i",
        "-e",
        "ORCHICON_MCP_TENANT_ID=tnt_dev",
        "orchicon-cnt-prod",
        "orchicon",
        "mcp"
      ],
      "enabled": true
    },
    "orchicon-dev": {
      "type": "local",
      "command": [
        "docker",
        "exec",
        "-i",
        "-e",
        "ORCHICON_MCP_TENANT_ID=tnt_dev",
        "orchicon-cnt-dev",
        "orchicon",
        "mcp"
      ],
      "enabled": false
    }
  }
}